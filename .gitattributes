# The transfer contract is byte-exact: the folder is the Aokie repository's, compared with it by sha256, so every file in it keeps LF
# endings on every checkout (the fixtures, transfer-v1.md, SHA256SUMS, and the OAIY-only ones under oaiy-only/).
docs/contracts/transfer/** text eol=lf

# The web app's sources and the code it shares are LF in every checkout. A machine with core.autocrlf=true would otherwise check them out
# with CRLF, and the header templates (a `\r` at the end of a header value), the mutation runner and the tests that match on exact text
# would each fail in a way that looks like a bug in the code. `text=auto` leaves binary files (fonts, images) alone.
/web/** text=auto eol=lf
/shared/** text=auto eol=lf

# The relay client core: LF in every checkout. A machine with core.autocrlf=true would otherwise check the crate out with CRLF, and its mutation harness (multi-line anchors),
# its fixtures and the generators under tests/ would each fail in a way that looks like a bug in the code.
crates/oaiy-relay-core/** text eol=lf
# and the three files of its dependency that the harness's dependency mutants patch (the crate's tests of its small-order and sealed-box checks).
crates/oaiy-crypto/src/** text eol=lf

# The Mac's shell scripts, and the Python launcher a Mac's build carries: LF in every checkout. A shell script checked out with CRLF on Windows and
# carried to a Mac does not run there (its first line names an interpreter that ends in a carriage return).
tools/mac/** text eol=lf
tools/engine-smoke.sh text eol=lf
crates/oaiy-studio/src/egpu_serve.py text eol=lf
