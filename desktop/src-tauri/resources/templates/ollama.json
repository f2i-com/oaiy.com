{
  "id": "ollama",
  "name": "Ollama",
  "description": "Multi-model LLM server. Installs system-wide.",
  "category": "LLM",
  "defaultPort": 11434,
  "install": {
    "kind": "script",
    "windows": "install-ollama.ps1",
    "unix": "install-ollama.sh"
  },
  "run": {
    "command": "ollama",
    "args": [
      "serve"
    ],
    "env": {
      "OLLAMA_HOST": "127.0.0.1:${port}",
      "OLLAMA_ORIGINS": "*"
    }
  },
  "health": {
    "url": "http://127.0.0.1:${port}/api/tags",
    "timeoutSecs": 15
  },
  "docsUrl": "https://github.com/ollama/ollama",
  "node": {
    "endpoint": "/v1/chat/completions",
    "method": "POST",
    "bodyTemplate": "{\"model\": \"${ollamaModel}\", \"messages\": [{\"role\": \"system\", \"content\": {{system}}}, {\"role\": \"user\", \"content\": {{input}}}], \"stream\": false}",
    "responsePath": "choices.0.message.content",
    "icon": "🤖"
  }
}
