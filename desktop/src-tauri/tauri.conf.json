{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OAIY",
  "version": "0.1.0",
  "identifier": "com.oaiy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OAIY — Companion",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local AI services + browser automation for oaiy-web",
    "longDescription": "OAIY is a tray-resident desktop app that manages local AI services (Ollama, ComfyUI, custom Python) and browser automation, exposing them to the oaiy-web flow editor via a localhost API."
  },
  "plugins": {}
}
