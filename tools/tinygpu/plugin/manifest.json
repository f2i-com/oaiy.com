{
  "schemaVersion": 4,
  "id": "egpu",
  "name": "eGPU",
  "version": "0.2.0",
  "publisher": "OAIY",
  "description": "An NVIDIA card in a Thunderbolt enclosure for OAIY's engines on a Mac, through tinygrad's TinyGPU driver: its own Python, tinygrad, the card's server and its kernels compiled ahead of time for the RTX 30, 40 and 50 series, so neither Docker nor a compiler is needed. Its setup installs the TinyGPU driver and finds the card; for another card, or a newer model, it sets up NVIDIA's compiler in Docker and makes the kernels.",
  "pluginApiVersion": 1,
  "minDesktopVersion": "0.1.0",
  "entry": {
    "kind": "process",
    "command": "python/bin/python3.12",
    "args": [
      "-I",
      "-B",
      "card/plugin.py"
    ]
  },
  "capabilities": [
    "connector.egpu.card.runtime",
    "connector.egpu.card.status",
    "connector.egpu.setup.status",
    "connector.egpu.driver.install",
    "connector.egpu.driver.openSettings",
    "connector.egpu.docker.download",
    "connector.egpu.docker.start",
    "connector.egpu.compiler.install",
    "connector.egpu.kernels.make"
  ],
  "connectors": [
    {
      "id": "egpu",
      "name": "eGPU",
      "commands": [
        "card.runtime",
        "card.status",
        "setup.status",
        "driver.install",
        "driver.openSettings",
        "docker.download",
        "docker.start",
        "compiler.install",
        "kernels.make"
      ]
    }
  ],
  "commands": {
    "journalled": [
      "driver.install",
      "compiler.install",
      "kernels.make"
    ]
  },
  "modules": {
    "provides": [
      "egpu"
    ],
    "connector": "egpu"
  },
  "setup": {
    "version": 1,
    "title": "Set up your eGPU",
    "steps": [
      {
        "id": "driver",
        "title": "TinyGPU driver",
        "description": "tinygrad's driver lets this Mac talk to an NVIDIA card. Install it, then allow it in System Settings.",
        "kind": "screen",
        "screen": "egpu",
        "view": "driver",
        "done": {
          "command": "setup.status",
          "path": "steps.driver",
          "equals": true
        }
      },
      {
        "id": "card",
        "title": "Your card",
        "description": "Connect the enclosure and turn it on. OAIY finds the card on Thunderbolt.",
        "kind": "screen",
        "screen": "egpu",
        "view": "card",
        "done": {
          "command": "setup.status",
          "path": "steps.card",
          "equals": true
        }
      },
      {
        "id": "kernels",
        "title": "Kernels for your card",
        "description": "The plugin carries kernels for RTX 30, 40 and 50 series cards. Another card's are made for it once, by NVIDIA's compiler in Docker.",
        "kind": "screen",
        "screen": "egpu",
        "view": "kernels",
        "when": {
          "command": "setup.status",
          "path": "kernels.inPack",
          "equals": false
        },
        "done": {
          "command": "setup.status",
          "path": "steps.kernels",
          "equals": true
        }
      },
      {
        "id": "compiler",
        "title": "NVIDIA's compiler",
        "description": "Optional: the plugin carries the kernels OAIY's models use. A model newer than the plugin may need more; NVIDIA's compiler makes them, and on a Mac it runs in Docker.",
        "optional": true,
        "kind": "screen",
        "screen": "egpu",
        "view": "compiler",
        "done": {
          "command": "setup.status",
          "path": "steps.compiler",
          "equals": true
        }
      }
    ]
  },
  "ui": {
    "nav": [
      {
        "id": "egpu",
        "label": "eGPU",
        "icon": "gpu",
        "screen": "egpu"
      }
    ],
    "screens": [
      {
        "id": "egpu",
        "title": "eGPU",
        "entry": "ui/egpu/index.html",
        "files": [
          "ui/egpu/index.html",
          "ui/egpu/egpu.css",
          "ui/egpu/egpu.js"
        ]
      }
    ],
    "statusCards": [
      {
        "id": "card",
        "title": "eGPU",
        "poll": {
          "command": "card.status",
          "intervalMs": 30000
        },
        "fields": [
          {
            "label": "Ready",
            "path": "ready"
          },
          {
            "label": "Why not",
            "path": "why"
          },
          {
            "label": "Driver allowed",
            "path": "driver.enabled"
          },
          {
            "label": "Kernels",
            "path": "pack.kernels"
          },
          {
            "label": "tinygrad",
            "path": "tinygrad"
          }
        ]
      }
    ],
    "overview": [
      {
        "id": "egpu-card",
        "kind": "status",
        "title": "eGPU",
        "icon": "gpu",
        "module": "egpu",
        "bind": {
          "value": "$poll.card.state",
          "detail": "$poll.card.detail"
        }
      }
    ]
  }
}
