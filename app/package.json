{
  "name": "bot.computer",
  "version": "0.1.0",
  "private": true,
  "description": "A coding agent that runs entirely in the browser: projects in a local virtual filesystem, AI-written code sandboxed on the Zipp VM, and any local or cloud model.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fetch-zipp.mjs --ensure",
    "fetch:zipp": "node scripts/fetch-zipp.mjs",
    "fetch:softn": "node scripts/fetch-softn.mjs",
    "softn:guide": "node scripts/generate-softn-guide.mjs",
    "softn:knowledge": "node scripts/generate-softn-knowledge.mjs",
    "dev": "vite",
    "build": "node scripts/fetch-zipp.mjs --ensure && tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && vite preview",
    "build:desktop": "node scripts/fetch-softn.mjs --ensure && npm run build",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:portable": "node scripts/desktop-portable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs && node tests/e2e/app.mjs && node tests/e2e/files.mjs && node tests/e2e/softn.mjs && node tests/e2e/csp.mjs && node tests/e2e/nrob.mjs && node tests/e2e/static.mjs --build"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "mediabunny": "^1.60.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "puppeteer-core": "^24.22.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.1",
    "vitest": "^4.0.0"
  }
}
