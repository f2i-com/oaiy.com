 {
  "type": "text_to_speech",
  "name": "Text to Speech",
  "module": "core-audio",
  "description": "Convert text to natural speech. Internal mode uses the OAIY DramaBox engine (local, fast, voice cloning). External mode drives any HTTP TTS service (ElevenLabs, OpenAI, Chatterbox, your own).",
  "inputs": [
   {
    "id": "text",
    "type": "string"
   },
   {
    "id": "descriptionInput",
    "type": "string"
   },
   {
    "id": "audioPrompt",
    "type": "audio"
   }
  ],
  "outputs": [
   {
    "id": "audio",
    "type": "audio"
   },
   {
    "id": "path",
    "type": "string"
   }
  ],
  "properties": [
   {
    "id": "service",
    "type": "select"
   },
   {
    "id": "provider",
    "type": "select",
    "default": "external",
    "options": [
     "external"
    ]
   },
   {
    "id": "internalModel",
    "type": "select",
    "default": "dramabox-v1",
    "options": [
     "dramabox-v1"
    ]
   },
   {
    "id": "internalCfgScale",
    "type": "number",
    "default": 2.5
   },
   {
    "id": "internalDurationSeconds",
    "type": "number",
    "default": 0
   },
   {
    "id": "internalStreaming",
    "type": "boolean",
    "default": false
   },
   {
    "id": "internalFastMode",
    "type": "boolean",
    "default": false
   },
   {
    "id": "internalSeed",
    "type": "number",
    "default": 0
   },
   {
    "id": "externalPreset",
    "type": "select",
    "default": "elevenlabs",
    "options": [
     "elevenlabs",
     "openai-tts",
     "chatterbox-tts",
     "qwen3-tts",
     "custom"
    ]
   },
   {
    "id": "externalUrl",
    "type": "string",
    "default": "https://api.elevenlabs.io/v1/text-to-speech/{{speaker}}"
   },
   {
    "id": "externalApiKeyConstant",
    "type": "string",
    "default": "ELEVENLABS_API_KEY"
   },
   {
    "id": "externalMethod",
    "type": "select",
    "default": "POST",
    "options": [
     "POST",
     "GET"
    ]
   },
   {
    "id": "externalHeaders",
    "type": "string",
    "default": "{\"Content-Type\": \"application/json\", \"xi-api-key\": \"{{apiKey}}\"}"
   },
   {
    "id": "externalBodyTemplate",
    "type": "string",
    "default": "{\"text\": {{text}}, \"model_id\": \"eleven_multilingual_v2\"}"
   },
   {
    "id": "externalResponseType",
    "type": "select",
    "default": "binary_mp3",
    "options": [
     "binary_mp3",
     "binary_wav",
     "base64_mp3",
     "base64_wav",
     "url",
     "file_path"
    ]
   },
   {
    "id": "externalResponsePath",
    "type": "string"
   },
   {
    "id": "description",
    "type": "string"
   },
   {
    "id": "speaker",
    "type": "string"
   },
   {
    "id": "language",
    "type": "select",
    "default": "Auto",
    "options": [
     "Auto",
     "English",
     "Chinese",
     "Japanese",
     "Korean",
     "Spanish",
     "French",
     "German",
     "Portuguese"
    ]
   },
   {
    "id": "outputFormat",
    "type": "select",
    "default": "wav",
    "options": [
     "wav",
     "mp3"
    ]
   },
   {
    "id": "filename",
    "type": "string",
    "default": "tts_output"
   }
  ]
 },
