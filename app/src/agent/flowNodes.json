  "name": "Video Captions",
  "module": "core-video",
  "description": "Add text captions/subtitles overlay to a video. Automatically times captions based on narration segments.",
  "inputs": [
   {
    "id": "video",
    "type": "video"
   },
   {
    "id": "text",
    "type": "string"
   },
   {
    "id": "durations",
    "type": "array"
   },
   {
    "id": "segments",
    "type": "array"
   }
  ],
  "outputs": [
   {
    "id": "video",
    "type": "video"
   }
  ],
  "properties": [
   {
    "id": "position",
    "type": "select",
    "default": "bottom",
    "options": [
     "top",
     "center",
     "bottom"
    ]
   },
   {
    "id": "fontSize",
    "type": "number",
    "default": 48
   },
   {
    "id": "fontColor",
    "type": "string",
    "default": "white"
   },
   {
    "id": "backgroundColor",
    "type": "string",
    "default": "black@0.7"
   },
   {
    "id": "padding",
    "type": "number",
    "default": 15
   },
   {
    "id": "margin",
    "type": "number",
    "default": 50
   }
  ]
 },
 {
  "type": "video_downloader",
  "name": "Video Downloader",
  "module": "core-video",
  "description": "Download videos or audio from YouTube, Vimeo, Twitter, TikTok, and 1000+ more sites",
  "inputs": [
   {
    "id": "url",
    "type": "string"
   },
   {
    "id": "mode",
    "type": "string"
   },
   {
    "id": "start",
    "type": "number"
   },
   {
    "id": "end",
    "type": "number"
   },
   {
    "id": "quality",
    "type": "string"
   }
  ],
  "outputs": [
   {
    "id": "video",
    "type": "video"
   },
   {
    "id": "duration",
    "type": "number"
   },
   {
    "id": "width",
    "type": "number"
   },
   {
    "id": "height",
    "type": "number"
   }
  ],
  "properties": []
 },
 {
  "type": "video_frame_extractor",
  "name": "Video Frames",
  "module": "core-video",
  "description": "Extract frames from a video file.",
  "inputs": [
   {
    "id": "video",
    "type": "video"
   },
   {
    "id": "timestamps",
    "type": "array"
   },
   {
    "id": "startTimeInput",
    "type": "number"
   },
   {
    "id": "endTimeInput",
    "type": "number"
   }
  ],
  "outputs": [
   {
    "id": "frames",
    "type": "array"
   }
  ],
  "properties": [
   {
    "id": "fps",
    "type": "number",
    "default": 1
   },
   {
    "id": "maxFrames",
    "type": "number",
    "default": 100
   },
   {
    "id": "startTime",
    "type": "number",
    "default": 0
   },
   {
    "id": "endTime",
    "type": "number",
    "default": 0
   },
   {
    "id": "outputFormat",
    "type": "select",
    "default": "jpeg",
    "options": [
     "jpeg",
     "png"
    ]
   },
   {
    "id": "lastFrameOnly",
    "type": "boolean",
    "default": false
   },
   {
    "id": "batchSize",
    "type": "number",
    "default": 10
   }
  ]
 },
 {
  "type": "video_gen",
  "name": "Video Gen",
  "module": "core-video",
  "description": "Generate videos using ComfyUI workflows or other local video APIs.",
  "inputs": [
   {
    "id": "prompt",
    "type": "string"
   },
   {
    "id": "image",
    "type": "image"
   },
   {
    "id": "image_end",
    "type": "image"
   },
   {
    "id": "frameCount",
    "type": "number"
   },
   {
    "id": "duration",
    "type": "number"
   },
   {
    "id": "audio",
    "type": "audio"
   }
  ],
  "outputs": [
   {
    "id": "video",
    "type": "video"
   }
  ],
  "properties": [
   {
    "id": "service",
    "type": "select"
   },
   {
    "id": "apiFormat",
    "type": "select",
    "default": "comfyui",
    "options": [
     "comfyui"
    ]
   },
   {
    "id": "wan2gpModel",
    "type": "select",
    "default": "ltx2_22B_distilled",
    "options": [
     "ltx2_22B_distilled",
     "ltx2_22B",
     "ltx2_19B",
     "t2v",
     "t2v_1.3B",
     "i2v",
     "i2v_720p",
     "t2v_2_2",
     "hunyuan_t2v"
    ]
   },
   {
    "id": "wan2gpDuration",
    "type": "number",
    "default": 5
   },
   {
    "id": "wan2gpResolution",
    "type": "select",
    "default": "832x480",
    "options": [
     "3840x2176",
     "2176x3840",
     "3840x1664",
     "1664x3840",
     "2560x1440",
     "1440x2560",
     "1920x1440",
     "1440x1920",
     "2160x1440",
     "1440x2160",
     "1440x1440",
     "2688x1152"
    ]
   },
   {
    "id": "wan2gpSteps",
    "type": "number",
    "default": 8
   },
   {
    "id": "endpoint",
    "type": "string"
   },
   {
    "id": "comfyWorkflow",
    "type": "json"
   },
   {
    "id": "comfyWorkflowName",
    "type": "string"
   },
   {
    "id": "comfyPrimaryPromptNodeId",
    "type": "string"
   },
   {
    "id": "comfyImageInputConfigs",
    "type": "json",
    "default": []
   },
   {
    "id": "comfySeedMode",
    "type": "string",
    "default": "random"
   },
   {
    "id": "comfyFixedSeed",
    "type": "number",
    "default": null
   },
   {
    "id": "comfyAllImageNodeIds",
    "type": "json",
    "default": []
   },
   {
    "id": "comfyFrameCount",
    "type": "number",
    "default": null
   },
   {
    "id": "comfyWidth",
    "type": "number",
    "default": null
   },
   {
    "id": "comfyHeight",
    "type": "number",
    "default": null
   },
   {
    "id": "comfyFrameRate",
    "type": "number",
    "default": null
   }
  ]
 },
 {
  "type": "video_pip",
  "name": "Video PiP",
  "module": "core-video",
  "description": "Overlay a picture-in-picture video (like a talking head) on top of a main video.",
  "inputs": [
   {
    "id": "mainVideo",
    "type": "video"
   },
   {
    "id": "pipVideo",
    "type": "video"
   }
  ],
  "outputs": [
   {
    "id": "video",
    "type": "video"
   }
  ],
  "properties": [
   {
    "id": "position",
    "type": "select",
    "default": "bottom-right",
    "options": [
     "top-left",
     "top-right",
     "bottom-left",
     "bottom-right"
    ]
   },
   {
    "id": "size",
    "type": "number",
    "default": 25
   },
   {
    "id": "margin",
    "type": "number",
    "default": 20
   },
   {
    "id": "shape",
    "type": "select",
    "default": "rectangle",
    "options": [
     "rectangle",
     "rounded",
     "circle"
    ]
   },
   {
    "id": "startTime",
    "type": "number",
    "default": 0
   },
   {
    "id": "pipDuration",
    "type": "number",
    "default": 0
   },
   {
    "id": "mainVolume",
    "type": "number",
    "default": 1
   },
   {
    "id": "pipVolume",
    "type": "number",
    "default": 1
   }
  ]
 },
 {
  "type": "video_save",
  "name": "Video Save",
  "module": "core-video",
  "description": "Save a video to a file on disk.",
  "inputs": [
   {
    "id": "video",
    "type": "video"
   }
  ],
  "outputs": [
   {
    "id": "path",
    "type": "video"
   }
  ],
  "properties": [
   {
    "id": "path",
    "type": "string"
   },
   {
    "id": "filename",
    "type": "string",
    "default": "video"
   },
   {
    "id": "format",
    "type": "select",
    "default": "mp4",
    "options": [
     "mp4",
     "webm"
    ]
   }
  ]
 }
]
