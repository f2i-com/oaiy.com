{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "oaiy-core": ["../ui/vendor/oaiy-core/src/index.ts"],
      "oaiy-core/modules/*": ["../ui/src/bundled-modules/*"],
      "oaiy-core/*": ["../ui/vendor/oaiy-core/*"],
      "@tauri-apps/api/core": ["./src/node-host/core.ts"],
      "@tauri-apps/plugin-sql": ["./src/node-host/sql.ts"]
    }
  },
  "include": ["src"]
}
