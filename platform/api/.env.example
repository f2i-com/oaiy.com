# Copy to .env and fill in. .env is gitignored.

# Database backend — "sqlite" (default, zero-setup) or "mysql".
# SQLite is recommended for solo deployments and demos; switch to
# MySQL when you have more than a few users + want hot backups +
# concurrent writes from multiple PHP-FPM workers.
DB_DRIVER=sqlite

# SQLite file path. Relative to the api/ folder; absolute paths also
# work. The directory will be created if missing on first connect.
# Ignored when DB_DRIVER=mysql.
DB_SQLITE_PATH=var/oaiy.sqlite

# MySQL / MariaDB connection — used when DB_DRIVER=mysql. PDO under
# the hood, so any TCP-reachable server works. For local WAMP/MAMP/
# XAMPP point at 127.0.0.1:3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oaiy_web
DB_USER=root
DB_PASS=

# Where the UI lives — used to compose share URLs returned by POST /flows.
# Trailing slash is stripped; default works for the Vite dev server.
UI_BASE=http://localhost:5175

# CORS — comma-separated list of allowed origins for the API. `*` is the
# permissive default so external AI tools can POST from anywhere; tighten
# this in production if you want flows to only be drivable from your own
# tools.
CORS_ALLOW_ORIGIN=*

# Long-poll timeout for /runs/pending in seconds. Browsers keep an open
# request for this long waiting for a queued run. Lower = more requests
# but faster recovery from disconnects.
POLL_TIMEOUT=20

# Cap on queued runs per flow to stop a runaway external caller from
# burying the browser. Excess runs return 429.
MAX_QUEUED_RUNS=10

# Seconds a run may sit in "running" before it's eligible to be reset to a
# terminal "error" (so external pollers don't wait forever for a dead browser).
# Floored at 60s. A run is only reaped when it's BOTH older than this AND its
# flow has stopped heartbeating (see REAP_LIVENESS_SECONDS), so a live worker on
# a long job is never force-failed — raise this for very long video/batch jobs.
RUN_TTL=900

# How long a flow must go without a heartbeat/poll (its browser sends one every
# ~30s, even mid-run) before it counts as gone for reaping. Floored at 30s.
REAP_LIVENESS_SECONDS=120

# Max bytes for a single run's inputs / result payload (and roughly the flow
# blob). Turns an oversized/forged body into a clean 413 instead of an opaque DB
# packet error. The real per-request bound is PHP post_max_size (~8MB default).
MAX_PAYLOAD_BYTES=16777216

# ---- Retention (used by `php bin/gc.php`; see Operations below) ----
# Days to keep terminal runs (done/error/cancelled) before deletion.
RUN_RETENTION_DAYS=7
# Days a flow may be idle (last_seen old) before it + its runs are reclaimed.
FLOW_IDLE_DAYS=30
# Days to keep a never-opened "drive-by" flow (last_seen NULL) before deletion.
FLOW_NEVER_SEEN_DAYS=7
#
# IMPORTANT: gc.php is the ONLY reclamation path — schedule it or the DB grows
# unbounded (POST /api/flows is unauthenticated). Example hourly cron:
#   0 * * * *  cd /path/to/api && php bin/gc.php >> /var/log/oaiy-gc.log 2>&1

# Error verbosity. Leave unset/false in production — internal 500s then
# return a generic "Internal server error" instead of leaking DB/SQL
# driver messages and stack traces to HTTP callers. Set to "true" only
# while debugging locally.
APP_DEBUG=false

# Folder the desktop-companion service library is served from
# (GET /api/service-library + /{file}). Defaults to api/service-library/.
# Set this to relocate the library outside the api/ tree if you prefer.
#SERVICE_LIBRARY_DIR=service-library
