{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaiy.com/schemas/bridge/v1/connector-response.schema.json",
  "title": "Connector command response",
  "type": "object",
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "result": {
      "description": "Present when ok."
    },
    "error": {
      "$ref": "https://oaiy.com/schemas/bridge/v1/error.schema.json"
    },
    "requestId": {
      "type": "string",
      "maxLength": 128
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ]
}
