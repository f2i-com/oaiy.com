{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaiy.com/schemas/relay/v1/compat-frames-accepted.schema.json",
  "title": "Aokie frames post response",
  "description": "200 response of the frames post: how many frames were stored (all or none), the seq of the last, and the relay's clock.",
  "type": "object",
  "properties": {
    "accepted": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "seq": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/uint53"
    },
    "time": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/unixTime"
    }
  },
  "required": [
    "accepted",
    "seq",
    "time"
  ],
  "additionalProperties": false
}
