{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaiy.com/schemas/relay/v1/admission-mobile-response.schema.json",
  "title": "Mobile admission response",
  "description": "Exactly the phone decoder's members. `device` carries ISO 8601 strings. expectedPeerKeyThumbprint is advisory to the phone: its pin comes only from the MAC-verified offer. `device` has exactly the eight members of the phone's DeviceRecord (deny_unknown_fields), and its grants equal `scopes` as an ordered list (a rule the schema cannot state; the conformance suite checks it). The phone accepts expiresIn 1 to 300 and expiresAt in (now, now + 300].",
  "type": "object",
  "properties": {
    "accessToken": {
      "type": "string",
      "pattern": "^aokie-adm-v2\\.[0-9a-f]+\\.[0-9a-f]{64}$",
      "maxLength": 8192
    },
    "tokenType": {
      "const": "Bearer"
    },
    "expiresIn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "expiresAt": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/unixTime"
    },
    "gatewayUrl": {
      "type": "string",
      "pattern": "^wss://[A-Za-z0-9.-]+(:[0-9]{1,5})?/v2/realtime$"
    },
    "appId": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/appId"
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/grant"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "iceServers": {
      "type": "array",
      "items": {
        "$ref": "https://oaiy.com/schemas/relay/v1/ice-server.schema.json"
      }
    },
    "relayOnly": {
      "type": "boolean"
    },
    "turnCredentialExpiresAt": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/unixTimeOrNull"
    },
    "holderKeyThumbprint": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/thumbprint"
    },
    "relay": {
      "type": "object",
      "properties": {
        "challengeUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "framesUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "streamUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "mode": {
          "const": "poll"
        }
      },
      "required": [
        "challengeUrl",
        "framesUrl",
        "streamUrl"
      ],
      "additionalProperties": false
    },
    "subjectId": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/deviceId"
    },
    "role": {
      "const": "mobile"
    },
    "expectedPeerKeyThumbprint": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/thumbprint"
    },
    "device": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/deviceId"
        },
        "appId": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/appId"
        },
        "subjectId": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/deviceId"
        },
        "role": {
          "const": "mobile"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/grant"
          },
          "maxItems": 16
        },
        "approvedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
        },
        "lastSeenAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
        }
      },
      "required": [
        "id",
        "appId",
        "subjectId",
        "role",
        "displayName",
        "grants",
        "approvedAt",
        "lastSeenAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "accessToken",
    "tokenType",
    "expiresIn",
    "expiresAt",
    "gatewayUrl",
    "appId",
    "subjectId",
    "role",
    "holderKeyThumbprint",
    "expectedPeerKeyThumbprint",
    "scopes",
    "iceServers",
    "relayOnly",
    "turnCredentialExpiresAt",
    "device",
    "relay"
  ],
  "additionalProperties": false
}
