{
  "protocol": "oaiy-relay/1",
  "title": "Frames posted and read through the relay",
  "about": "A conversation through POST and GET /v1/aokie-companion/relay/frames, in order, with the bearers of admission.json. Request bodies are what the shipped carriers send (relay_post_body embeds the frames as they are).",
  "relay": {
    "url": "https://relay.example.com",
    "clock": 1790000000,
    "stunUrls": [
      "stun:stun.example.com:3478"
    ],
    "turnUrls": [
      "turn:turn.example.com:3478?transport=udp",
      "turns:turn.example.com:5349?transport=tcp"
    ],
    "turnSecret": "0123456789abcdef0123456789abcdef",
    "turnTtl": 600,
    "admissionSecretHex": "0101010101010101010101010101010101010101010101010101010101010101"
  },
  "bearers": {
    "plugin": "aokie-adm-v2..f7f70ef2b3172742a1c35137e6543606ebfbcbedfa5f26e2bb35a5bd140ec5c0",
    "phone A": "aokie-adm-v2..95b5577679c52089de3a723ff01abe45a821408bcc564dac578ad6b3346165e4",
    "phone B": "aokie-adm-v2..a71682a6420cc87e6a3ace94e7c301bfce0926bb63562b461676f7846ff02565"
  },
  "steps": [
    {
      "step": "phone A posts three frames to the plugin",
      "from": "phone A",
      "request": {
        "method": "POST",
        "path": "/v1/aokie-companion/relay/frames",
        "auth": "Bearer of phone A",
        "body": {
          "to": "plugin",
          "frames": [
            {},
            {
              "type": "hello",
              "n": 9007199254740993,
              "f": 1.0,
              "u": "héllo 😀/",
              "e": {},
              "a": [],
              "z": [
                {}
              ]
            },
            {
              "kind": "snapshot",
              "grants": [
                "state_read"
              ],
              "seq": 999
            }
          ]
        },
        "bodyText": "{\"to\":\"plugin\",\"frames\":[{},{\"type\":\"hello\",\"n\":9007199254740993,\"f\":1.0,\"u\":\"héllo 😀/\",\"e\":{},\"a\":[],\"z\":[{}]},{\"kind\":\"snapshot\",\"grants\":[\"state_read\"],\"seq\":999}]}"
      },
      "response": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "accepted": 3,
          "seq": 3,
          "time": 1790000000
        }
      },
      "note": "The frames are stored as decoded and encoded again: {} stays an object, 9007199254740993 an integer, 1.0 a float, slashes and Unicode as they are. The relay records who posted them; nothing in a frame can say so."
    },
    {
      "step": "the plugin reads them",
      "from": "plugin",
      "request": {
        "method": "GET",
        "path": "/v1/aokie-companion/relay/frames",
        "query": {
          "since": "0",
          "wait": "0"
        },
        "auth": "Bearer of the plugin"
      },
      "response": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "frames": [
            {
              "seq": 1,
              "from": "mobile:--6IM5l0OosLj9yWskISYhUA3n_3CURQkmrYMSha_ck",
              "subjectId": "dev-sLGys7S1tre4ubq7vL2-vw",
              "grants": [
                "state_read",
                "caller_read",
                "captions_read",
                "rtc_signal"
              ],
              "frame": {}
            },
            {
              "seq": 2,
              "from": "mobile:--6IM5l0OosLj9yWskISYhUA3n_3CURQkmrYMSha_ck",
              "subjectId": "dev-sLGys7S1tre4ubq7vL2-vw",
              "grants": [
                "state_read",
                "caller_read",
                "captions_read",
                "rtc_signal"
              ],
              "frame": {
                "type": "hello",
                "n": 9007199254740993,
                "f": 1.0,
                "u": "héllo 😀/",
                "e": {},
                "a": [],
                "z": [
                  {}
                ]
              }
            },
            {
              "seq": 3,
              "from": "mobile:--6IM5l0OosLj9yWskISYhUA3n_3CURQkmrYMSha_ck",
              "subjectId": "dev-sLGys7S1tre4ubq7vL2-vw",
              "grants": [
                "state_read",
                "caller_read",
                "captions_read",
                "rtc_signal"
              ],
              "frame": {
                "kind": "snapshot",
                "grants": [
                  "state_read"
                ],
                "seq": 999
              }
            }
          ],
          "lastSeq": 3,
          "time": 1790000000
        }
      },
      "note": "from, subjectId and grants are the relay's record of phone A's admission, not the frame's own members (the third frame claims seq 999)."
    },
    {
      "step": "the plugin finds the tail",
      "from": "plugin",
      "request": {
        "method": "GET",
        "path": "/v1/aokie-companion/relay/frames",
        "query": {
          "since": "3",
          "wait": "0"
        },
        "auth": "Bearer of the plugin"
      },
      "response": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "frames": [],
          "lastSeq": 3,
          "time": 1790000000
        }
      },
      "note": "How the plugin primes its cursor (tail_cursor reads lastSeq): with nothing after since, lastSeq is since."
    },
    {
      "step": "the plugin posts two frames to phone A",
      "from": "plugin",
      "request": {
        "method": "POST",
        "path": "/v1/aokie-companion/relay/frames",
        "auth": "Bearer of the plugin",
        "body": {
          "to": "mobile:--6IM5l0OosLj9yWskISYhUA3n_3CURQkmrYMSha_ck",
          "frames": [
            {
              "kind": "plugin_idle"
            },
            {
              "kind": "lease_granted",
              "deviceId": "dev-sLGys7S1tre4ubq7vL2-vw"
            }
          ]
        },
        "bodyText": "{\"to\":\"mobile:--6IM5l0OosLj9yWskISYhUA3n_3CURQkmrYMSha_ck\",\"frames\":[{\"kind\":\"plugin_idle\"},{\"kind\":\"lease_granted\",\"deviceId\":\"dev-sLGys7S1tre4ubq7vL2-vw\"}]}"
      },
      "response": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "accepted": 2,
          "seq": 2,
          "time": 1790000000
        }
      }
    },
    {
      "step": "phone A reads them",
      "from": "phone A",
      "request": {
        "method": "GET",
        "path": "/v1/aokie-companion/relay/frames",
        "query": {
          "since": "0",
          "wait": "0"
        },
        "auth": "Bearer of phone A"
      },
      "response": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "frames": [
            {
              "seq": 1,
              "from": "plugin",
              "subjectId": "aokie",
              "grants": [
                "state_read",
                "rtc_signal"
              ],
              "frame": {
                "kind": "plugin_idle"
              }
            },
            {
              "seq": 2,
              "from": "plugin",
              "subjectId": "aokie",
              "grants": [
                "state_read",
                "rtc_signal"
              ],
              "frame": {
                "kind": "lease_granted",
                "deviceId": "dev-sLGys7S1tre4ubq7vL2-vw"
              }
            }
          ],
          "lastSeq": 2,
          "time": 1790000000
        }
      },
      "note": "Reading does not acknowledge: the same read answers the same until the frames' 120 seconds are up."
    },
    {
      "step": "phone A reads them again, from where it left off",
      "from": "phone A",
      "request": {
        "method": "GET",
        "path": "/v1/aokie-companion/relay/frames",
        "query": {
          "since": "1",
          "wait": "0"
        },
        "auth": "Bearer of phone A"
      },
      "response": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "frames": [
            {
              "seq": 2,
              "from": "plugin",
              "subjectId": "aokie",
              "grants": [
                "state_read",
                "rtc_signal"
              ],
              "frame": {
                "kind": "lease_granted",
                "deviceId": "dev-sLGys7S1tre4ubq7vL2-vw"
              }
            }
          ],
          "lastSeq": 2,
          "time": 1790000000
        }
      }
    },
    {
      "step": "phone B has nothing",
      "from": "phone B",
      "request": {
        "method": "GET",
        "path": "/v1/aokie-companion/relay/frames",
        "query": {
          "since": "0",
          "wait": "0"
        },
        "auth": "Bearer of phone B"
      },
      "response": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "frames": [],
          "lastSeq": 0,
          "time": 1790000000
        }
      },
      "note": "A mailbox is the party's own."
    }
  ]
}
