{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaiy.com/schemas/relay/v1/pairing-fetch-response.schema.json",
  "title": "Rendezvous state",
  "description": "200 response of GET /v1/pair/{pid}. An unknown, an expired and a burned pid are one 404 with an identical body and timing. `hold` appears only when the request waited (wait > 0 on a live, unchanged rendezvous) and means what it means on a poll: granted, granted and superseded by a newer wait, or refused because the pool is nearly full (the answer is then the state as it is now, at once).",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "state": {
      "enum": [
        "open",
        "answered",
        "approved",
        "denied"
      ]
    },
    "offer": {
      "type": "string",
      "maxLength": 4096
    },
    "mac": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/key32"
    },
    "exp": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/unixTime"
    },
    "deviceId": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/deviceId"
    },
    "sealedToken": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/b64u"
    },
    "receipt": {
      "type": "object",
      "description": "The desktop's approval receipt (README section 4.10.2), with the grants it was signed over: the desktop signs the grants and the phone never sees the decision, so the relay returns the sorted set, exactly the one the signature covers. The phone verifies the signature over exactly these grants (a relay that changes them fails the verification) and refuses a name it does not know.",
      "properties": {
        "issuedAt": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/unixTime"
        },
        "signature": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/signature"
        },
        "grants": {
          "type": "array",
          "description": "The grants of the approval, sorted (code-point order of the names), without repeats: the set in the canonical receipt document the signature covers.",
          "items": {
            "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/grant"
          },
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "issuedAt",
        "signature",
        "grants"
      ],
      "additionalProperties": true
    },
    "time": {
      "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/unixTime"
    },
    "hold": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "granted": {
              "const": true
            },
            "superseded": {
              "const": true
            }
          },
          "required": [
            "granted"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "refused": {
              "const": true
            },
            "retryAfter": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            }
          },
          "required": [
            "refused",
            "retryAfter"
          ],
          "additionalProperties": true
        }
      ]
    }
  },
  "required": [
    "v",
    "state",
    "time"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "open",
              "answered"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "offer",
          "mac",
          "exp"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "approved"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "deviceId",
          "sealedToken",
          "receipt"
        ]
      }
    }
  ]
}
