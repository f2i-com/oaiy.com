{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaiy.com/schemas/relay/v1/admission-claims.schema.json",
  "title": "Admission claims (aokie-adm-v2)",
  "description": "The JSON inside an aokie-adm-v2 bearer. Exactly these members; the two role shapes are mutually exclusive. Insertion order is stable so fixtures and incident review are easy: aud, appId, subjectId, role, holderKeyThumbprint, then the role's peer members, then scopes, dsk, exp, jti. `dsk` is read only by the relay. TTL 90 seconds by default and never more than 300.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "aud": {
          "const": "aokie-v2-gateway"
        },
        "appId": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/appId"
        },
        "holderKeyThumbprint": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/thumbprint"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/grant"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "dsk": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/deviceId"
        },
        "exp": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/unixTime"
        },
        "jti": {
          "type": "string",
          "pattern": "^adm_[0-9a-f]{32}$"
        },
        "subjectId": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/deviceId"
        },
        "role": {
          "const": "mobile"
        },
        "expectedPeerKeyThumbprint": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/thumbprint"
        }
      },
      "required": [
        "aud",
        "appId",
        "subjectId",
        "role",
        "holderKeyThumbprint",
        "expectedPeerKeyThumbprint",
        "scopes",
        "dsk",
        "exp",
        "jti"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "aud": {
          "const": "aokie-v2-gateway"
        },
        "appId": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/appId"
        },
        "holderKeyThumbprint": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/thumbprint"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/grant"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "dsk": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/deviceId"
        },
        "exp": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/unixTime"
        },
        "jti": {
          "type": "string",
          "pattern": "^adm_[0-9a-f]{32}$"
        },
        "subjectId": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/appId"
        },
        "role": {
          "const": "plugin"
        },
        "approvedPeerKeyThumbprints": {
          "type": "array",
          "items": {
            "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/thumbprint"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "peerRosterRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "peerRosterHash": {
          "$ref": "https://oaiy.com/schemas/relay/v1/common.schema.json#/$defs/key32"
        }
      },
      "required": [
        "aud",
        "appId",
        "subjectId",
        "role",
        "holderKeyThumbprint",
        "approvedPeerKeyThumbprints",
        "peerRosterRevision",
        "peerRosterHash",
        "scopes",
        "dsk",
        "exp",
        "jti"
      ],
      "additionalProperties": false
    }
  ]
}
