{
  "id": "formlogic",
  "name": "FormLogic",
  "description": "Link this machine to a FormLogic account so it can run flows, relay connector commands, and act as a desktop runtime.",
  "docsUrl": "https://formlogic.com/docs/desktop",
  "defaultBaseUrl": "https://formlogic.com",
  "auth": {
    "kind": "oauth2_pkce",
    "clientId": "oaiy-desktop",
    "authorizePath": "/oauth/authorize",
    "tokenPath": "/api/oauth/token",
    "callbackPath": "/callback",
    "deviceParam": "device",
    "extraAuthorizeParams": {
      "response_type": "code"
    },
    "scopes": [
      "flows:read",
      "flows:write",
      "responses:read",
      "responses:write",
      "responses:manage",
      "connector:relay",
      "aokie:realtime"
    ],
    "tokenResponse": {
      "credentialFields": ["formlogic_api_key", "access_token"],
      "accountIdField": "desktop_connection_id",
      "accountNameField": "device_name",
      "scopeField": "scope"
    }
  },
  "healthPath": "/api/v1/desktop-connections",
  "relay": {
    "pendingPath": "/api/v1/connector-commands/pending",
    "claimPath": "/api/v1/connector-commands/{id}/claim",
    "completePath": "/api/v1/connector-commands/{id}/complete",
    "waitSeconds": 25,
    "batchLimit": 20,
    "errorBackoffSeconds": 10
  },
  "desktopAi": {
    "pubkeyPath": "/api/v1/desktop-ai/pubkey",
    "pendingPath": "/api/v1/desktop-ai/pending",
    "claimPath": "/api/v1/desktop-ai/{id}/claim",
    "framesPath": "/api/v1/desktop-ai/{id}/frames",
    "completePath": "/api/v1/desktop-ai/{id}/complete",
    "waitSeconds": 25,
    "batchLimit": 8,
    "errorBackoffSeconds": 10
  },
  "dataNode": {
    "registerPath": "/api/v1/data-node/register",
    "selfPath": "/api/v1/data-node/self",
    "intervalSeconds": 3600,
    "capabilities": ["storage"],
    "protocolMin": 1,
    "protocolMax": 1
  },
  "heartbeat": {
    "path": "/api/v1/desktop-connections",
    "intervalSeconds": 45,
    "instanceIdField": "desktopInstanceId",
    "deviceNameField": "deviceName"
  }
}
