{
  "id": "formlogic",
  "name": "FormLogic",
  "description": "Link this machine to a FormLogic account so it can run flows, relay connector commands, and act as a desktop runtime.",
  "docsUrl": "https://formlogic.com/docs/desktop",
  "defaultBaseUrl": "https://formlogic.com",
  "auth": {
    "kind": "oauth2_pkce",
    "clientId": "oaiy-desktop",
    "authorizePath": "/oauth/authorize",
    "tokenPath": "/api/oauth/token",
    "callbackPath": "/callback",
    "deviceParam": "device",
    "extraAuthorizeParams": {
      "response_type": "code"
    },
    "scopes": [
      "flows:read",
      "flows:write",
      "responses:read",
      "responses:write",
      "responses:manage",
      "connector:relay",
      "aokie:realtime"
    ],
    "tokenResponse": {
      "credentialFields": [
        "formlogic_api_key",
        "access_token"
      ],
      "accountIdField": "desktop_connection_id",
      "accountNameField": "device_name",
      "scopeField": "scope"
    }
  },
  "healthPath": "/api/v1/desktop-connections",
  "relay": {
    "pendingPath": "/api/v1/connector-commands/pending",
    "claimPath": "/api/v1/connector-commands/{id}/claim",
    "completePath": "/api/v1/connector-commands/{id}/complete",
    "waitSeconds": 25,
    "batchLimit": 20,
    "errorBackoffSeconds": 10
  },
  "desktopAi": {
    "pubkeyPath": "/api/v1/desktop-ai/pubkey",
    "pendingPath": "/api/v1/desktop-ai/pending",
    "claimPath": "/api/v1/desktop-ai/{id}/claim",
    "framesPath": "/api/v1/desktop-ai/{id}/frames",
    "completePath": "/api/v1/desktop-ai/{id}/complete",
    "inputPath": "/api/v1/desktop-ai/{id}/input",
    "toolsCatalogPath": "/api/ai/chat-tools/catalog",
    "toolsExecutePath": "/api/ai/chat-tools/execute",
    "waitSeconds": 25,
    "batchLimit": 8,
    "errorBackoffSeconds": 10
  },
  "flows": {
    "bindingsPath": "/api/v1/flow-bindings",
    "reservePath": "/api/v1/flow-runs",
    "queuedPath": "/api/v1/flow-runs/queued",
    "claimPath": "/api/v1/flow-runs/{id}/claim",
    "completePath": "/api/v1/flow-runs/{id}",
    "graphPath": "/api/v1/flows",
    "nodes": [
      {
        "nodeType": "input",
        "operation": "runInput"
      },
      {
        "nodeType": "llm_chat",
        "operation": "chat"
      },
      {
        "nodeType": "formlogic_list_responses",
        "operation": "listRecords",
        "path": "/api/v1/forms/{form}/responses",
        "listResult": {
          "items": "responses",
          "count": "count",
          "first": "first",
          "found": "found"
        },
        "filters": {
          "field": "filters",
          "opKey": "op",
          "fieldKey": "field",
          "valueKey": "value",
          "ops": [
            {
              "op": "eq",
              "param": "answers.{field}"
            },
            {
              "op": "phone_eq",
              "param": "answersPhone.{field}"
            },
            {
              "op": "gte",
              "param": "answersGte.{field}"
            },
            {
              "op": "lte",
              "param": "answersLte.{field}"
            }
          ]
        }
      },
      {
        "nodeType": "formlogic_submit_response",
        "operation": "createRecord",
        "path": "/api/v1/forms/{form}/responses"
      },
      {
        "nodeType": "formlogic_update_response",
        "operation": "updateRecord",
        "path": "/api/v1/responses/{id}"
      },
      {
        "nodeType": "connector_request",
        "operation": "connectorRequest"
      },
      {
        "nodeType": "desktop_services",
        "operation": "serviceControl"
      }
    ],
    "selectors": {
      "sigil": "$",
      "negate": "!",
      "open": "{{",
      "close": "}}",
      "roots": [
        {
          "name": "result",
          "source": "runResult"
        },
        {
          "name": "event",
          "source": "runEvent"
        },
        {
          "name": "app",
          "source": "appContext"
        },
        {
          "name": "input",
          "source": "runInputs"
        },
        {
          "name": "inputs",
          "source": "runInputs"
        },
        {
          "name": "nodes",
          "source": "unavailable"
        },
        {
          "name": "upstream",
          "source": "unavailable"
        }
      ]
    },
    "inputMapField": "inputMap",
    "resultActions": {
      "actionsField": "outputActions",
      "errorsField": "outputActionErrors",
      "resultWrapper": "value",
      "maxActions": 16,
      "submitPath": "/api/v1/forms/{formId}/responses",
      "updatePath": "/api/v1/forms/{formId}/responses/{id}",
      "fields": {
        "kind": "type",
        "gate": "when",
        "formId": "form",
        "record": "answers",
        "recordId": "responseId",
        "message": "message",
        "connectorId": "connectorId",
        "command": "command",
        "payload": "payload",
        "id": "id"
      },
      "actions": [
        {
          "actionType": "formlogic.submitResponse",
          "operation": "submitRecord"
        },
        {
          "actionType": "formlogic.updateResponse",
          "operation": "updateRecord"
        },
        {
          "actionType": "formlogic.toast",
          "operation": "notify"
        },
        {
          "actionType": "connector.request",
          "operation": "connectorRequest"
        }
      ]
    }
  },
  "appLogic": {
    "path": "/api/v1/app-logic",
    "eventHook": "onConnectorEvent",
    "submitPath": "/api/v1/forms/{formId}/responses",
    "listPath": "/api/v1/forms/{formId}/responses",
    "updatePath": "/api/v1/forms/{formId}/responses/{id}",
    "matchScanLimit": 200,
    "fields": {
      "kind": "type",
      "formKey": "formKey",
      "record": "answers",
      "recordId": "responseId",
      "matchBlock": "match",
      "matchField": "field",
      "matchValue": "value",
      "upsert": "upsert",
      "storageKey": "key",
      "storageValue": "value",
      "message": "message",
      "level": "level",
      "connectorId": "connectorId",
      "command": "command",
      "payload": "payload",
      "items": "responses",
      "id": "id",
      "effectsList": "effects"
    },
    "catalogue": {
      "apps": "apps",
      "appBlock": "app",
      "appId": "id",
      "appSlug": "slug",
      "logicBlock": "customLogic",
      "scripts": "scripts",
      "scriptId": "id",
      "scriptHook": "hook",
      "scriptSource": "source",
      "forms": "forms",
      "formId": "id",
      "formKey": "packFormId"
    },
    "effects": [
      {
        "effectType": "formlogic.submitResponse",
        "operation": "submitRecord"
      },
      {
        "effectType": "formlogic.updateResponse",
        "operation": "updateRecord"
      },
      {
        "effectType": "storage.set",
        "operation": "setStorage"
      },
      {
        "effectType": "ui.toast",
        "operation": "notify"
      },
      {
        "effectType": "formlogic.toast",
        "operation": "notify"
      },
      {
        "effectType": "connector.request",
        "operation": "connectorRequest"
      }
    ]
  },
  "dataNode": {
    "registerPath": "/api/v1/data-node/register",
    "selfPath": "/api/v1/data-node/self",
    "intervalSeconds": 3600,
    "capabilities": [
      "storage"
    ],
    "protocolMin": 1,
    "protocolMax": 1
  },
  "heartbeat": {
    "path": "/api/v1/desktop-connections",
    "intervalSeconds": 45,
    "instanceIdField": "desktopInstanceId",
    "deviceNameField": "deviceName"
  }
}
