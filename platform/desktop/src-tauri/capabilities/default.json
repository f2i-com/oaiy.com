{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the OAIY Companion's main window. Tray + shell-spawn are the only privileged surfaces needed in Phase 1.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:app:default",
    "core:tray:default",
    "shell:default",
    "dialog:default",
    "notification:default"
  ]
}
