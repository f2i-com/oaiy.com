{
  "about": "The 33 conformance vectors of the ring policy (design Appendix A.8). Each vector is the base input with `patch` laid over it (objects merged member by member, everything else replaced), and the plan it must give. Wednesday is day 3, 10:30 is minute 630, 22:15 is minute 1335, 06:30 is minute 390, 07:00 is minute 420.",
  "base": {
    "settings": {
      "enabled": true,
      "initiative": "on_request",
      "ringSeconds": 40,
      "phoneRing": "when_away",
      "desktopRing": "auto",
      "away": "auto",
      "desktopActiveSeconds": 120,
      "quietHours": { "enabled": true, "start": "21:00", "end": "07:00", "days": 127, "allowUrgent": false, "allowVip": true },
      "vipNumbers": [],
      "urgentPhrases": [],
      "limits": { "perCall": 2, "gapSeconds": 60, "perCallerHour": 3, "globalHour": 10 }
    },
    "presence": "active",
    "relayHealthy": true,
    "devices": [
      { "id": "pixel2", "role": "second_device", "kind": "android", "callAuthority": true, "canTake": true, "online": false, "pushable": true, "availability": "available" }
    ],
    "call": { "reason": "caller_asked", "callerAskedConfirmed": true, "urgentConfirmed": false, "callerIsVip": false },
    "limits": { "attemptsThisCall": 0, "secondsSinceLastAttempt": null, "callerAttemptsLastHour": 0, "globalAttemptsLastHour": 0 },
    "now": { "day": 3, "minutes": 630 }
  },
  "vectors": [
    { "id": "V01", "case": "owner at the PC, phone when_away: desktop only", "patch": {}, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 30, "phones": [], "wake": [], "desktopToast": true, "desktopCompanions": [] } },
    { "id": "V02", "case": "owner idle: phone woken by push, no desktop toast", "patch": { "presence": "idle" }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 40, "phones": ["pixel2"], "wake": ["pixel2"], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V03", "case": "phoneRing always: desktop and phone together", "patch": { "settings": { "phoneRing": "always" } }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 40, "phones": ["pixel2"], "wake": ["pixel2"], "desktopToast": true, "desktopCompanions": [] } },
    { "id": "V04", "case": "sideload phone polling and not pushable: rung through its poll", "patch": { "presence": "idle", "devices": [{ "id": "pixel2", "role": "second_device", "kind": "android", "callAuthority": true, "canTake": true, "online": true, "pushable": false, "availability": "available" }] }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 40, "phones": ["pixel2"], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V05", "case": "PC off and phone do-not-disturb", "patch": { "presence": "off", "devices": [{ "id": "pixel2", "role": "second_device", "kind": "android", "callAuthority": true, "canTake": true, "online": false, "pushable": true, "availability": "do_not_disturb" }] }, "expect": { "decision": "message_only", "reason": "all_do_not_disturb", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V06", "case": "PC off and no phone paired", "patch": { "presence": "off", "devices": [] }, "expect": { "decision": "message_only", "reason": "no_endpoint", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V07", "case": "quiet hours 22:15", "patch": { "now": { "minutes": 1335 } }, "expect": { "decision": "message_only", "reason": "quiet_hours", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V08", "case": "quiet hours 06:30 (overnight window)", "patch": { "now": { "minutes": 390 } }, "expect": { "decision": "message_only", "reason": "quiet_hours", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V09", "case": "quiet hours edge 07:00 is outside", "patch": { "now": { "minutes": 420 } }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 30, "phones": [], "wake": [], "desktopToast": true, "desktopCompanions": [] } },
    { "id": "V10", "case": "quiet hours 22:15, VIP caller passes", "patch": { "now": { "minutes": 1335 }, "call": { "callerIsVip": true } }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 30, "phones": [], "wake": [], "desktopToast": true, "desktopCompanions": [] } },
    { "id": "V11", "case": "quiet hours 22:15, urgent but allowUrgent off", "patch": { "now": { "minutes": 1335 }, "settings": { "initiative": "on_request_or_urgent" }, "call": { "reason": "urgent", "urgentConfirmed": true } }, "expect": { "decision": "message_only", "reason": "quiet_hours", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V12", "case": "quiet hours 22:15, urgent and allowUrgent on (owner idle)", "patch": { "now": { "minutes": 1335 }, "presence": "idle", "settings": { "initiative": "on_request_or_urgent", "quietHours": { "allowUrgent": true } }, "call": { "reason": "urgent", "urgentConfirmed": true } }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 40, "phones": ["pixel2"], "wake": ["pixel2"], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V13", "case": "AI wants to transfer on its own, initiative on_request", "patch": { "call": { "reason": "policy_rule" } }, "expect": { "decision": "message_only", "reason": "initiative_off", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V14", "case": "AI claims urgent, the caller-turn check did not confirm it", "patch": { "settings": { "initiative": "on_request_or_urgent" }, "call": { "reason": "urgent", "urgentConfirmed": false } }, "expect": { "decision": "message_only", "reason": "not_urgent", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V15", "case": "second attempt inside 60 s", "patch": { "limits": { "attemptsThisCall": 1, "secondsSinceLastAttempt": 30 } }, "expect": { "decision": "refused", "reason": "limit_gap", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V16", "case": "third attempt on one call", "patch": { "limits": { "attemptsThisCall": 2, "secondsSinceLastAttempt": 300 } }, "expect": { "decision": "refused", "reason": "limit_call", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V17", "case": "same caller fourth time this hour", "patch": { "limits": { "callerAttemptsLastHour": 3 } }, "expect": { "decision": "refused", "reason": "limit_caller", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V18", "case": "same caller fourth time, VIP exempt", "patch": { "limits": { "callerAttemptsLastHour": 3 }, "call": { "callerIsVip": true } }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 30, "phones": [], "wake": [], "desktopToast": true, "desktopCompanions": [] } },
    { "id": "V19", "case": "tenth global attempt this hour", "patch": { "limits": { "globalAttemptsLastHour": 10 } }, "expect": { "decision": "refused", "reason": "limit_global", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V20", "case": "master switch off", "patch": { "settings": { "enabled": false } }, "expect": { "decision": "message_only", "reason": "disabled", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V21", "case": "away mode on: no desktop toast even though active", "patch": { "settings": { "away": "on" } }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 40, "phones": ["pixel2"], "wake": ["pixel2"], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V22", "case": "desktopRing never, phone when_away, owner active", "patch": { "settings": { "desktopRing": "never" } }, "expect": { "decision": "message_only", "reason": "no_endpoint", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V23", "case": "the gateway handset is never a target (owner idle)", "patch": { "presence": "idle", "devices": [{ "id": "pixel2", "role": "gateway_handset", "kind": "android", "callAuthority": true, "canTake": true, "online": false, "pushable": true, "availability": "available" }] }, "expect": { "decision": "message_only", "reason": "no_endpoint", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V24", "case": "ring seconds clamp: 5 becomes 20 (owner idle)", "patch": { "presence": "idle", "settings": { "ringSeconds": 5 } }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 20, "phones": ["pixel2"], "wake": ["pixel2"], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V25", "case": "ring seconds clamp: 500 becomes 90 (owner idle)", "patch": { "presence": "idle", "settings": { "ringSeconds": 500 } }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 90, "phones": ["pixel2"], "wake": ["pixel2"], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V26", "case": "Windows Companion online, PC active", "patch": { "devices": [{ "id": "pixel2", "role": "second_device", "kind": "android", "callAuthority": true, "canTake": true, "online": false, "pushable": true, "availability": "available" }, { "id": "win1", "role": "second_device", "kind": "windows", "callAuthority": true, "canTake": true, "online": true, "pushable": false, "availability": "available" }] }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 30, "phones": [], "wake": [], "desktopToast": true, "desktopCompanions": ["win1"] } },
    { "id": "V27", "case": "phone unreachable (no push, not connected, owner idle)", "patch": { "presence": "idle", "devices": [{ "id": "pixel2", "role": "second_device", "kind": "android", "callAuthority": true, "canTake": true, "online": false, "pushable": false, "availability": "available" }] }, "expect": { "decision": "message_only", "reason": "no_endpoint", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V28", "case": "quiet-hours day mask excludes Wednesday, 22:15", "patch": { "now": { "minutes": 1335 }, "settings": { "quietHours": { "days": 119 } } }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 30, "phones": [], "wake": [], "desktopToast": true, "desktopCompanions": [] } },
    { "id": "V29", "case": "away on: the Windows Companion on the PC is not rung", "patch": { "settings": { "away": "on" }, "devices": [{ "id": "pixel2", "role": "second_device", "kind": "android", "callAuthority": true, "canTake": true, "online": false, "pushable": true, "availability": "available" }, { "id": "win1", "role": "second_device", "kind": "windows", "callAuthority": true, "canTake": true, "online": true, "pushable": false, "availability": "available" }] }, "expect": { "decision": "ring", "reason": "ok", "ringSeconds": 40, "phones": ["pixel2"], "wake": ["pixel2"], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V30", "case": "the AI says caller_asked but no caller turn asked", "patch": { "call": { "callerAskedConfirmed": false } }, "expect": { "decision": "refused", "reason": "caller_did_not_ask", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V31", "case": "relay unreachable: a push-only phone is not rung (owner idle)", "patch": { "presence": "idle", "relayHealthy": false }, "expect": { "decision": "message_only", "reason": "no_endpoint", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V32", "case": "relay unreachable: even a connected phone cannot be rung (owner idle)", "patch": { "presence": "idle", "relayHealthy": false, "devices": [{ "id": "pixel2", "role": "second_device", "kind": "android", "callAuthority": true, "canTake": true, "online": true, "pushable": false, "availability": "available" }] }, "expect": { "decision": "message_only", "reason": "no_endpoint", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } },
    { "id": "V33", "case": "a phone without the take-transfers grants is never rung (owner idle)", "patch": { "presence": "idle", "devices": [{ "id": "pixel2", "role": "second_device", "kind": "android", "callAuthority": true, "canTake": false, "online": false, "pushable": true, "availability": "available" }] }, "expect": { "decision": "message_only", "reason": "no_endpoint", "ringSeconds": 0, "phones": [], "wake": [], "desktopToast": false, "desktopCompanions": [] } }
  ]
}
