# /etc/oaiy/oaiy.env — the settings of oaiy-server, read by the unit (oaiy-server.service) AND by oaiyctl.
# One KEY=VALUE per line; blank lines and lines starting with # or ; are skipped; one pair of quotes round a value is
# removed; nothing is evaluated. Install it root:oaiy, mode 0640 (it holds the token).

# All state lives under one folder (databases, venvs, downloaded models, templates). It is the folder the console
# works in too: change it here and nowhere else.
OAIY_DATA_DIR=/var/lib/oaiy
OAIY_MODELS_DIR=/var/lib/oaiy/models

# Port (loopback only). Front it with nginx/Caddy + TLS if it is exposed.
OAIY_SERVER_PORT=17972

# The bearer token every request except health, capability discovery and the pairing bootstrap must present
# (Authorization: Bearer <token>): the CLI and anything else that manages this server. 32 to 256 printable characters,
# at least 16 different. Set a long random one. Left empty, the server answers ONLY those three public routes.
OAIY_SERVER_TOKEN=

# Behind a proxy (the web login): the https hosts of the dashboard and the two apps, and the proxies to believe.
# OAIY_PUBLIC_URL=https://dash.example.com
# OAIY_AGENT_URL=https://agent.example.com
# OAIY_FLOWS_URL=https://flows.example.com
# OAIY_TRUSTED_PROXIES=127.0.0.1

# Where a sign-in may come from (addresses and networks; a typo in the list stops the server from starting).
# OAIY_LOGIN_ALLOW=203.0.113.0/24

# HuggingFace token for the server's own gated model downloads. It is not passed on to the services and installers
# the server starts.
# OAIY_HF_TOKEN=
