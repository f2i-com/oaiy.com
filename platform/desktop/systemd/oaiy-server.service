[Unit]
Description=OAIY server (headless companion — services/models/python API on 127.0.0.1:17972)
Documentation=https://oaiy.com
After=network-online.target
Wants=network-online.target
# A start that fails is tried again (Restart= below), but not for ever: five starts in a minute and the unit stays
# failed (systemctl reset-failed oaiy-server, after the settings are put right). This bounds what
# RestartPreventExitStatus= below cannot: a failing ExecStartPre is not "the main process" exiting 78.
# Requires systemd 230 or newer: StartLimitIntervalSec= and StartLimitBurst= are read in [Unit] from that version (an older
# systemd ignores them here with a warning. If `systemctl --version` says less, move both to [Service] and rename the
# first to StartLimitInterval=: that is its name there before 230, which does not know StartLimitIntervalSec=).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Run as a dedicated unprivileged user you create:
#   useradd --system --shell /usr/sbin/nologin oaiy
# (StateDirectory below auto-creates /var/lib/oaiy owned by oaiy — no manual mkdir.)
User=oaiy
Group=oaiy

# Every OAIY_ setting is in ONE file, and this unit sets none of its own: `oaiyctl` (the console) reads the same file,
# so that the console works in the folder the server keeps its data in. Install it from the example beside this unit:
#   install -d -m 0755 /etc/oaiy
#   install -m 0640 -o root -g oaiy oaiy.env.example /etc/oaiy/oaiy.env
# (root:oaiy 0640: the token in it is read by root for the service, and by the oaiy user through the group.)
# The unit does not start without the file. One KEY=VALUE per line.
EnvironmentFile=/etc/oaiy/oaiy.env

ExecStart=/usr/local/bin/oaiy-server
# Refuses to start on a configuration the server would refuse (exit 78), and says why, before the server runs.
ExecStartPre=/usr/local/bin/oaiy-server check
# A refusal of the configuration (exit 78) is not restarted: it would refuse again. (That is the main process only: a
# failing `check` above is tried again, and StartLimit* above ends it.)
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3

# oaiy-server stops its plugins and every managed service on SIGTERM before exiting.
KillSignal=SIGTERM
TimeoutStopSec=30

# State dir: systemd auto-creates /var/lib/oaiy (+ /var/lib/oaiy/models) owned by
# oaiy:oaiy at 0700 on first start, and keeps it writable under ProtectSystem=strict
# — so no manual mkdir/chown and no separate ReadWritePaths is needed.
StateDirectory=oaiy oaiy/models
StateDirectoryMode=0700

# Hardening (relax if a managed service needs more).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
