{
  "name": "oaiy-webapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "The OAIY web app's shared providers origin, and the scripts and browser tests that assemble and check its three hosts.",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build --config providers/vite.config.ts",
    "assemble": "node scripts/assemble.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "npm run build && node --test --test-concurrency=2 --test-timeout=180000 \"tests/e2e/cases/**/*.test.mjs\"",
    "test:mutations": "node tests/e2e/mutations.mjs",
    "test": "npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "esbuild": "0.28.2",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
